node ('Sandy') {

    stage('Get veg code from GitHub') {
        def revision = checkout scm
        echo "Checked out veg at Git commit ${revision.GIT_COMMIT}"
    }
    /*specify python 3.13 in build for SonarQube compatability*/
    stage('Build') {

        echo 'Verifying Python version'
        bat 'py -3.13 --version'

        echo 'Creating Python 3.13 virtual environment'
        bat 'py -3.13 -m venv .venv313'

        echo 'Installing application and testing dependencies'
        bat '.venv313\\Scripts\\python.exe -m pip install -r Build\\requirements.txt'

        echo 'Checking Python syntax'
        bat '.venv313\\Scripts\\python.exe -m compileall Code Tests'
    }

    stage('Automated Testing') {

        echo 'Executing automated Python tests'

        withCredentials([string(credentialsId: 'ButtersVegSecretKey', variable: 'BUTTERS_VEG_SECRET_KEY')]) {

            try { /*specify python 3.13 in testing for SonarQube compatability*/
               bat '.venv313\\Scripts\\python.exe -m pytest Tests -v --junitxml=TestResults.xml --cov=Code.ButtersVegApp --cov-report=term-missing --cov-report=xml:coverage.xml --cov-report=html'
            }
            finally {
                junit 'TestResults.xml'

                archiveArtifacts artifacts: 'coverage.xml,htmlcov/**',
                                 allowEmptyArchive: true
            }
        }
    }

    stage('Static Analysis - SonarQube') {

        def scannerHome = tool 'SonarScanner'

        withSonarQubeEnv('SonarQube') {

            bat "\"${scannerHome}\\bin\\sonar-scanner.bat\""

        }

    stage('Vulnerability Scanning - pip-audit') {

        echo 'Installing Python vulnerability scanner'

        bat '.venv313\\Scripts\\python.exe -m pip install pip-audit==2.10.1'

        echo 'Scanning Python dependencies for known vulnerabilities'

        bat '.venv313\\Scripts\\python.exe -m pip_audit --local'
    }
    }
    def ImageTag = ''
    def LocalImage = ''

    stage('Docker Build') {

        echo 'Checking Docker availability'

        bat 'docker version'

        ImageTag = bat(
            script: '@git rev-parse HEAD',
            returnStdout: true
        ).trim()

        LocalImage = "butters-veg:${ImageTag}"

        echo "Building Docker image ${LocalImage}"

        // Check for an updated base image following the Trivy scan.
        // --no-cache to the Docker build command to ensure the security updates are applied afresh
       bat "docker build --pull --no-cache -f Release/DockerFile -t ${LocalImage} ."
    }

    stage('Container Smoke Test') {

        withCredentials([
            string(
                credentialsId: 'ButtersVegSecretKey',
                variable: 'BUTTERS_VEG_SECRET_KEY'
            )
        ]) {

            try {

                bat "docker run -d --name butters-veg-test-${env.BUILD_NUMBER} -p 127.0.0.1:5001:5000 -e BUTTERS_VEG_SECRET_KEY ${LocalImage}"

                retry(5) {
                    sleep time: 5, unit: 'SECONDS'

                    bat 'curl.exe --fail --silent --show-error http://127.0.0.1:5001/ -o ContainerTest.html'
                }

                bat 'findstr /I /C:"Butters Veg" ContainerTest.html'

                echo 'Butters Veg container smoke test passed'

            } finally {

                bat returnStatus: true,
                    script: "docker logs butters-veg-test-${env.BUILD_NUMBER}"

                bat returnStatus: true,
                    script: "docker rm -f butters-veg-test-${env.BUILD_NUMBER}"
            }
        }
    }

   /* stage('Container Security - Trivy') {

        echo 'Scanning Docker image for known vulnerabilities'

        bat "docker save -o ButtersVegImage.tar ${LocalImage}"

        try {

            bat "docker run --rm -v \"%CD%:/scan\" aquasec/trivy:0.76.2 image --input /scan/ButtersVegImage.tar --severity HIGH,CRITICAL --exit-code 1"

        } finally {

            bat returnStatus: true,
                script: 'del /Q ButtersVegImage.tar'
        }
    }*/

    stage('Release - Docker Hub') {

        withCredentials([
            usernamePassword(
                credentialsId: 'DockerHubCredentials',
                usernameVariable: 'DOCKERHUB_USERNAME',
                passwordVariable: 'DOCKERHUB_TOKEN'
            )
        ]) {

            try {
                //change to windows command prompt
                bat '''
                    @echo off
                    echo %DOCKERHUB_TOKEN%| docker login --username "%DOCKERHUB_USERNAME%" --password-stdin
                '''

                def ReleaseImage = "${env.DOCKERHUB_USERNAME}/butters-veg:${ImageTag}"

                bat "docker tag ${LocalImage} ${ReleaseImage}"

                bat "docker push ${ReleaseImage}"

                echo "Successfully released ${ReleaseImage}"

            } finally {

                bat returnStatus: true,
                    script: 'docker logout'
            }
        }
    }




}
