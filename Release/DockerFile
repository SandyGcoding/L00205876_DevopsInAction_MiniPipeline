# Build stage using Python 3.13 and Alpine Linux.
FROM python:3.13-alpine AS builder

WORKDIR /Build

# Update the Python package installer.
RUN python -m pip install --no-cache-dir --upgrade pip

COPY Release/requirements.txt .

# Install application runtime dependencies.
RUN python -m pip install --no-cache-dir \
    --prefix=/install -r requirements.txt


# Minimal runtime stage.
FROM python:3.13-alpine

# Apply available Alpine security updates.
RUN apk upgrade --no-cache

# Update pip in the runtime image.
RUN python -m pip install --no-cache-dir --upgrade pip

WORKDIR /app

COPY --from=builder /install /usr/local

# Create a non-root application user.
RUN adduser -D appuser

COPY --chown=appuser:appuser Code/ButtersVegApp.py .
COPY --chown=appuser:appuser Code/Veg.xlsx .
COPY --chown=appuser:appuser Code/templates/ ./templates/
COPY --chown=appuser:appuser Code/static/ ./static/

RUN chown appuser:appuser /app

USER appuser

EXPOSE 5000

CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "1", "--threads", "4", "--access-logfile", "-", "ButtersVegApp:app"]
