FROM python:3.13-slim-bookworm AS builder

WORKDIR /Build
COPY Release/requirements.txt .

RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

FROM python:3.13-slim-bookworm

# Security remediation following the initial Trivy scan.
# Trivy identified 54 HIGH severity findings in the Debian base image.
# Refresh the package index and apply available security updates.
# Remove cached package lists to minimise the final image size.
# Vulnerabilities without available patches may remain.

RUN apt-get update \
    && apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /install /usr/local

RUN useradd --create-home appuser

COPY --chown=appuser:appuser Code/ButtersVegApp.py .
COPY --chown=appuser:appuser Code/Veg.xlsx .
COPY --chown=appuser:appuser Code/templates/ ./templates/
COPY --chown=appuser:appuser Code/static/ ./static/

RUN chown appuser:appuser /app

USER appuser

EXPOSE 5000

CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "1", "--threads", "4", "--access-logfile", "-", "ButtersVegApp:app"]
